# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_PORT=27017
MONGO_URI=mongodb://admin:changeme@localhost:27017/?authSource=admin
MONGO_DB_NAME=wrc_landing

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_LANDING_BUCKET=wrc-landing-docs
MINIO_TRANSFORMED_BUCKET=wrc-transformed-docs

# scraper specific
WRC_BASE_URL=https://www.workplacerelations.ie

# Number of months per partition, used when chunking date ranges for crawling/storage.
PARTITION_SIZE_MONTHS=1

CONCURRENT_REQUESTS=16
CONCURRENT_REQUESTS_PER_DOMAIN=8

# AutoThrottle: target/average concurrent requests to the site, initial delay(s),
# and the max backoff delay (s) it will ever wait even under heavy latency.
AUTOTHROTTLE_TARGET_CONCURRENCY=4
AUTOTHROTTLE_START_DELAY=1
AUTOTHROTTLE_MAX_DELAY=30

# How many times to retry a request that fails with a 429/5xx/408 response.
RETRY_TIMES=3

# Give up on a single request after this many seconds (still retried, per RETRY_TIMES).
DOWNLOAD_TIMEOUT=30
